# Local synthetic fixtures only. Never reuse these values in a hosted environment.
DATABASE_URL=postgres://app_login:local_app_only@localhost:5432/app
MIGRATION_DATABASE_URL=postgres://migration_login:local_migration_only@localhost:5432/app
SESSION_SECRET=replace-with-at-least-32-random-characters
